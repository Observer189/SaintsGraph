GridBackground {
    --grid-background-color: #1e1e1e;
    --line-color: rgba(200, 200, 200, 0.05);
    --thick-line-color: rgba(200, 200, 200, 0.09);
    --spacing: 16;
}

.saints-node-body {
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(46, 46, 46, 0.9);
}

.saints-port-row {
    flex-direction: row;
    align-items: center;
}

.saints-port-row .unity-label {
    min-width: 50px;
}

.saints-port-row .unity-base-field__label {
    min-width: 60px;
    width: 60px;
}

.saints-node-body > .unity-property-field {
    margin-left: 16px;
    margin-right: 16px;
}

.saints-node-body .unity-base-field__label {
    min-width: 60px;
}

.saints-node-in-cycle #node-border {
    border-color: #d65454;
    border-width: 2px;
}

.saints-dynamic-list {
    margin: 2px 6px;
}

.saints-dynamic-list__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.saints-dynamic-list__button {
    width: 20px;
    padding: 0;
    margin: 0 1px;
}



